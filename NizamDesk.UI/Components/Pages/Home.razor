@page "/"

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Welcome to NizamDesk</h1>
        <p class="lead text-muted">A simple project & task management system for learning and productivity.</p>
    </div>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">Projects</h5>
                    <p class="card-text">Manage projects and track progress.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">Users</h5>
                    <p class="card-text">Invite team members and assign roles.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">Tickets</h5>
                    <p class="card-text">Create, assign, and track tickets.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center">
                <a class="btn btn-outline-primary w-100" asp-controller="Home" asp-action="Login">GetStarted</a>
            </div>
        </div>
    </div>
</div>