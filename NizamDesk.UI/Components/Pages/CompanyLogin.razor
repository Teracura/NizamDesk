@using Teracura.TestingWebApp.Entities.Models
@rendermode InteractiveServer
<div class="d-flex justify-content-center align-items-center py-5">
    <div class="card shadow p-4" style="max-width: 500px; width: 100%;">

        <div class="card-body">
            <h3 class="text-center mb-4">Login</h3>

            <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator/>
                <ValidationSummary/>
                <p class="text-center">or sign in with email:</p>

                <div class="mb-3">
                    <label for="loginEmail" class="form-label">Company Name</label>
                    <InputText id="loginEmail" type="email" class="form-control" @bind-Value="_loginModel.Name"/>
                </div>

                <div class="mb-3 position-relative">
                    <label for="loginPassword" class="form-label">Password</label>
                    <InputText id="loginPassword" type="@(_showPassword ? "text" : "password")" class="form-control"
                               @bind-Value="_loginModel.Password"/>
                </div>

                @if (_showErrorMessage)
                {
                    <div class="alert alert-danger text-center">@_errorMessage</div>
                }

                <button type="submit" class="btn btn-outline-primary w-100 mb-3">Sign in</button>

                <div class="text-center">
                    <p>Create your own company?
                        <NavLink class="text-primary" href="/register">Create Your company</NavLink>
                    </p>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<p class="h4 text-center mb-3">
    or Choose one of the companies you are a member of, [Name placeholder]
</p>


@code {
    private CompanyLoginModel _loginModel = new();
    private bool _showErrorMessage;
    private string _errorMessage;
    private bool _showPassword;

    private void HandleLogin()
    {
    }

}