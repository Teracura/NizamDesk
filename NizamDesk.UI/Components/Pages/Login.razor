@page "/login"

<div class="d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow p-4" style="max-width: 420px; width: 100%;">
        <div class="card-body">

            <h3 class="text-center mb-4">Login</h3>

            <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="text-center mb-3">
                    <p>Sign in with:</p>
                    <a class="btn btn-link mx-1" href="/login/google">
                        <img src="/images/google-color-icon.svg" alt="Google" width="30" height="30" />
                    </a>
                    <a class="btn btn-link mx-1" href="/login/discord">
                        <img src="/images/discord-round-color-icon.svg" alt="Discord" width="30" height="30" />
                    </a>
                    <a class="btn btn-link mx-1" href="/login/github">
                        <img src="/images/github-icon.svg" alt="Github" width="30" height="30" />
                    </a>
                </div>

                <p class="text-center">or:</p>

                <!-- Email -->
                <div class="mb-3">
                    <label for="loginName" class="form-label">Email or username</label>
                    <InputText id="loginName" class="form-control" @bind-Value="_loginModel.EmailOrUsername" />
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <label for="loginPassword" class="form-label">Password</label>
                    <InputText id="loginPassword" type="password" class="form-control" @bind-Value="_loginModel.Password" />
                </div>

                <!-- Remember -->
                <div class="form-check mb-3">
                    <InputCheckbox id="loginCheck" class="form-check-input" @bind-Value="_loginModel.RememberMe" />
                    <label for="loginCheck" class="form-check-label">Remember me</label>
                </div>

                <button type="submit" class="btn btn-primary w-100 mb-3">Sign in</button>

                <div class="text-center">
                    <p>Not a member? <NavLink class="text-primary" href="/register">Register</NavLink></p>
                </div>
            </EditForm>

        </div>
    </div>
</div>

@code {
    private LoginModel _loginModel { get; set; } = new();

    private void HandleLogin()
    {
        Console.WriteLine($"Login with {_loginModel.EmailOrUsername}");
    }

    public class LoginModel
    {
        public string? EmailOrUsername { get; set; }
        public string? Password { get; set; }
        public bool RememberMe { get; set; }
    }
}
