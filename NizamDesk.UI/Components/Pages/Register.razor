@page "/register"

<div class="d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow p-4" style="max-width: 500px; width: 100%;">
        <div class="card-body">

            <h3 class="text-center mb-4">Register</h3>

            <EditForm Model="@_registerModel" OnValidSubmit="HandleRegister">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label for="registerName" class="form-label">Name</label>
                    <InputText id="registerName" class="form-control" @bind-Value="_registerModel.Name" />
                </div>

                <div class="mb-3">
                    <label for="registerUsername" class="form-label">Username</label>
                    <InputText id="registerUsername" class="form-control" @bind-Value="_registerModel.Username" />
                </div>

                <div class="mb-3">
                    <label for="registerEmail" class="form-label">Email</label>
                    <InputText id="registerEmail" type="email" class="form-control" @bind-Value="_registerModel.Email" />
                </div>

                <div class="mb-3">
                    <label for="registerPassword" class="form-label">Password</label>
                    <InputText id="registerPassword" type="password" class="form-control" @bind-Value="_registerModel.Password" />
                </div>

                <div class="mb-3">
                    <label for="registerRepeatPassword" class="form-label">Repeat Password</label>
                    <InputText id="registerRepeatPassword" type="password" class="form-control" @bind-Value="_registerModel.RepeatPassword" />
                </div>

                <div class="form-check d-flex justify-content-center mb-3">
                    <InputCheckbox id="registerCheck" class="form-check-input me-2" @bind-Value="_registerModel.AcceptTerms" />
                    <label for="registerCheck" class="form-check-label">I agree to the terms</label>
                </div>

                <button type="submit" class="btn btn-primary w-100 mb-3">Register</button>

                <div class="text-center">
                    <p>Already a member? <NavLink class="text-primary" href="/login">Login</NavLink></p>
                </div>
            </EditForm>

        </div>
    </div>
</div>

@code {
    private RegisterModel _registerModel { get; set; } = new();

    private void HandleRegister()
    {
        Console.WriteLine($"Register user {_registerModel.Email}");
    }

    public class RegisterModel
    {
        public string? Name { get; set; }
        public string? Username { get; set; }
        public string? Email { get; set; }
        public string? Password { get; set; }
        public string? RepeatPassword { get; set; }
        public bool AcceptTerms { get; set; }
    }
}