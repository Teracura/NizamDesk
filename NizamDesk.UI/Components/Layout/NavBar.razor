@using Microsoft.AspNetCore.Components.Authorization
@using Teracura.TestingWebApp.Interfaces
@rendermode InteractiveServer
@inject IJSRuntime JS

<nav class="navbar navbar-expand-lg shadow-sm fixed-top bg-primary">
    <div class="container-fluid text-white">
        <a class="navbar-brand fw-bold text-white" href="/">
            NizamDesk
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
            <AuthorizeView>
                <Authorized>
                    <ul class="navbar-nav ms-auto ">
                        <li class="nav-item ">
                            <a class="btn btn-link nav-link text-white" href="/logout">Sign out</a>
                        </li>
                        <li class="nav-item">
                            <button class="btn btn-link nav-link" @onclick="ToggleTheme">
                                <img src="images/@(_isLightTheme ? "moon-icon.svg" : "sun-warm-icon.svg")"
                                     alt="Theme Icon"
                                     height="24"/>
                            </button>
                        </li>
                    </ul>
                </Authorized>
                <NotAuthorized>
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="btn btn-link nav-link text-white" href="/login">Login</a>
                        </li>
                        <li class="nav-item">
                            <button class=" btn btn-link nav-link" @onclick="ToggleTheme">
                                <img src="images/@(_isLightTheme ? "moon-icon.svg" : "sun-warm-icon.svg")"
                                     alt="Theme Icon"
                                     height="24"
                                     class="sun-warm-icon"/>
                            </button>
                        </li>
                    </ul>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</nav>

@code {
    private bool _isLightTheme = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var savedTheme = await JS.InvokeAsync<string>("themeHelper.getTheme");
            _isLightTheme = savedTheme == "light";
            await JS.InvokeVoidAsync("themeHelper.setTheme", _isLightTheme ? "light" : "dark");

            await JS.InvokeVoidAsync("eval",
                $"document.body.setAttribute('data-bs-theme', '{(_isLightTheme ? "light" : "dark")}')");

            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        _isLightTheme = !_isLightTheme;
        await JS.InvokeVoidAsync("themeHelper.setTheme", _isLightTheme ? "light" : "dark");

        await JS.InvokeVoidAsync("eval",
            $"document.body.setAttribute('data-bs-theme', '{(_isLightTheme ? "light" : "dark")}')");

        StateHasChanged();
    }
}